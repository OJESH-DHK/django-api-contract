  "components": {
    "schemas": {
      "Category": {
        "properties": {
          "name": {
            "maxLength": 80,
            "type": "string"
          },
          "slug": {
            "maxLength": 50,
            "pattern": "^[-a-zA-Z0-9_]+$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "type": "object"
      },
      "PaginatedCategoryList": {
        "properties": {
          "count": {
            "example": 123,
            "type": "integer"
          },
          "next": {
            "example": "http://api.example.org/accounts/?page=4",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "previous": {
            "example": "http://api.example.org/accounts/?page=2",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "results"
        ],
        "type": "object"
      },
      "PaginatedProductList": {
        "properties": {
          "count": {
            "example": 123,
            "type": "integer"
          },
          "next": {
            "example": "http://api.example.org/accounts/?page=4",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "previous": {
            "example": "http://api.example.org/accounts/?page=2",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "results"
        ],
        "type": "object"
      },
      "PatchedCategory": {
        "properties": {
          "name": {
            "maxLength": 80,
            "type": "string"
          },
          "slug": {
            "maxLength": 50,
            "pattern": "^[-a-zA-Z0-9_]+$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PatchedProduct": {
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "readOnly": true
          },
          "category_slug": {
            "type": "string",
            "writeOnly": true
          },
          "created_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "type": "string"
          },
          "price": {
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "type": "string"
          },
          "released_on": {
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "sku": {
            "maxLength": 32,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          }
        },
        "type": "object"
      },
      "PriceImport": {
        "properties": {
          "dry_run": {
            "default": true,
            "type": "boolean"
          },
          "prices": {
            "description": "CSV file with sku,price columns.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "prices"
        ],
        "type": "object"
      },
      "Product": {
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "readOnly": true
          },
          "category_slug": {
            "type": "string",
            "writeOnly": true
          },
          "created_at": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "type": "string"
          },
          "price": {
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "type": "string"
          },
          "released_on": {
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "sku": {
            "maxLength": 32,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          }
        },
        "required": [
          "category",
          "category_slug",
          "created_at",
          "name",
          "price",
          "sku"
        ],
        "type": "object"
      },
      "StatusEnum": {
        "description": "* `draft` - Draft\n* `published` - Published\n* `archived` - Archived",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "tokenAuth": {
        "description": "Token-based authentication with required prefix \"Token\"",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  }
}
